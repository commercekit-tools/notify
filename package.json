{
  "name": "@commercekit/notify-action",
  "version": "0.1.0",
  "private": true,
  "description": "Official GitHub Action for rich CommerceKit workflow notifications.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "schema:check": "node scripts/schema-check.mjs",
    "bundle": "ncc build src/main.ts --minify --license licenses.txt -o dist",
    "bundle:check": "node scripts/check-bundle.mjs",
    "audit": "pnpm audit --prod --audit-level=high",
    "scan:public": "node scripts/scan-public-files.mjs",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm schema:check && pnpm test:coverage && pnpm bundle:check && pnpm scan:public && pnpm audit",
    "payload:preview": "node scripts/payload-preview.mjs"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@commercekit-tools/notification-contract": "0.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vercel/ncc": "0.45.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
